QWidget {
    font-family: "Segoe UI", "Inter", "Helvetica Neue", sans-serif;
    font-size: 10pt;
    color: #1c1c20;
    background-color: #fafafc;
}
QMainWindow, QDialog { background-color: #fafafc; }
QListWidget#sidebar {
    background: #f0f0f4;
    border: none;
    padding: 4px;
}
QListWidget#sidebar::item {
    padding: 10px 14px;
    border-radius: 6px;
}
QListWidget#sidebar::item:selected {
    background: #d6e1ff;
    color: #182660;
}
QPushButton {
    background: #ffffff;
    border: 1px solid #c8c8d0;
    padding: 6px 12px;
    border-radius: 4px;
}
QPushButton:hover { background: #f0f4ff; }
QPushButton:pressed { background: #d6e1ff; }
QLineEdit, QPlainTextEdit, QListView, QTableView, QComboBox, QSpinBox {
    background: #ffffff;
    border: 1px solid #c8c8d0;
    padding: 4px;
    border-radius: 4px;
}
QGroupBox {
    border: 1px solid #d6d6dc;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #555560;
}
#StatusDot[state="ready"]    { color: #2da046; }
#StatusDot[state="paused"]   { color: #888896; }
#StatusDot[state="recording"], #StatusDot[state="transcribing"], #StatusDot[state="executing"] { color: #d4a017; }
#StatusDot[state="loading_model"] { color: #6080ff; }
#StatusDot[state="error"]    { color: #c14040; }
#Banner          { padding: 8px; border-radius: 4px; }
#Banner[kind="error"]   { background: #fde2e2; color: #8a1c1c; }
#Banner[kind="info"]    { background: #e1ecff; color: #1a3c8a; }
#Banner[kind="success"] { background: #e0f3e3; color: #1c5a26; }
